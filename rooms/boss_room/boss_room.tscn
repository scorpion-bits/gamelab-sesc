[sub_resource type="Resource" id="Resource_u3x5j"]
script = ExtResource("7_jt71r")
text = "[shake rate=20 level=5][b]MORRER![/b][/shake]"
duration = 2.0
portrait = ExtResource("8_bfv4j")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_k4pr2"]
script = ExtResource("7_jt71r")
text = "..."
duration = 0.5
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_ti20a"]
script = ExtResource("7_jt71r")
text = "Então você conseguiu chegar aqui."
duration = 1.5
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_bfv4j"]
script = ExtResource("7_jt71r")
text = "Devo cumprimenta-la pelo seu feito."
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_uf4o8"]
script = ExtResource("7_jt71r")
text = "Afinal de contas, você se esforçou tanto para...."
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_6m7vs"]
script = ExtResource("7_jt71r")
text = "Acabou, Majestade. Você escondeu cada saco de grão, cada gota de água, achando que conseguiria salvar a si mesmo enquanto seu povo morria de fome nas ruas. Onde está toda a sua glória agora?"
duration = 1.0
portrait = ExtResource("12_ujxrc")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_ipogx"]
script = ExtResource("7_jt71r")
text = "Glória? Aurora... não sobrou nada disso. Acha que fugir com os estoques foi escolha minha?"
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_ujxrc"]
script = ExtResource("7_jt71r")
text = "Não venha com desculpas. A decisão foi sua!"
duration = 1.0
portrait = ExtResource("12_ujxrc")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_uko5d"]
script = ExtResource("7_jt71r")
text = "Foi a nobreza! Eles me encurralaram. Sussurraram em meus ouvidos, exigiram que eu protegesse os privilégios deles, que esvaziasse os armazéns para manter o trono seguro. "
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_o1vsk"]
script = ExtResource("7_jt71r")
text = "No fim, eles me obrigaram a lutar esta guerra egoísta... e eu fui fraco o bastante para obedecer durante anos."
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_jkljd"]
script = ExtResource("7_jt71r")
text = "Sua fraqueza custou vidas. Muitos estão pagando o preço pela sua coroa."
duration = 1.0
portrait = ExtResource("12_ujxrc")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_7anrc"]
script = ExtResource("7_jt71r")
text = "Esta coroa... ela nunca teve valor real. Era apenas metal brilhante construído sobre a mentira de que eu importava mais do que o meu povo. Só percebi isso agora, tarde demais."
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_ojelp"]
script = ExtResource("7_jt71r")
text = "Arrependimento não vai encher o estômago de quem passou fome."
duration = 1.0
portrait = ExtResource("12_ujxrc")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_uja2u"]
script = ExtResource("7_jt71r")
text = "Eu sei. E não peço o seu perdão. Eu vou pagar por cada crime que cometi contra o meu povo. Leve-me para o julgamento. Estou pronto."
duration = 1.0
portrait = ExtResource("8_jt71r")
metadata/_custom_type_script = "uid://cqx633eegleoo"

