[sub_resource type="Resource" id="Resource_ymy75"]
script = ExtResource("11_at8ek")
text = "[shake rate=10 level=2]*Suspiro...*[/shake] Olá, Aurora. Eu já não sei mais o que fazer. Estas nas minhas mãos são as [color=orange]últimas sementes[/color] de toda a nossa vila..."
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_8rtv0"]
script = ExtResource("11_at8ek")
text = "Nós precisamos plantá-las rápido! Por que o senhor ainda não fez isso?"
duration = 1.0
portrait = ExtResource("13_l7vcl")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_jv8ax"]
script = ExtResource("11_at8ek")
text = "O único pedaço de [color=limegreen]terra fértil[/color] que nos restou está trancado atrás daquela porta. "
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_asv8l"]
script = ExtResource("11_at8ek")
text = "Se não plantarmos lá, as sementes não vão vingar e nosso povo vai passar fome."
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_at8ek"]
script = ExtResource("11_at8ek")
text = "O problema é que o mecanismo da porta só vai destravar se alguém conseguir empurrar todas aquelas [color=orange]caixas pesadas[/color] e deixá-las  em cima das [color=aqua]marcações no chão[/color]. "
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_cggem"]
script = ExtResource("11_at8ek")
text = "Eu estou muito fraco para isso..."
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_3dsbk"]
script = ExtResource("11_at8ek")
text = "Eu dou um jeito nisso! Eu empurro as caixas para o lugar certo e libero a passagem para o senhor."
duration = 1.0
portrait = ExtResource("13_l7vcl")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_l7vcl"]
script = ExtResource("11_at8ek")
text = "Você faria isso pela nossa comunidade? [wave amp=20 freq=4]Muito obrigado, pequena![/wave] 
Vá com calma. "
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_3bv3h"]
script = ExtResource("11_at8ek")
text = "Se você acabar empurrando uma caixa para um canto sem saída, volte a falar comigo que eu te ajudo a puxar todas de volta para o começo."
duration = 1.0
portrait = ExtResource("12_3dsbk")
metadata/_custom_type_script = "uid://cqx633eegleoo"

