[sub_resource type="Resource" id="Resource_uq1c4"]
script = ExtResource("8_t6lab")
text = "[shake rate=10 level=5][color=gray]*Cof, cof...*[/color][/shake] Ah... pequena [color=lightblue]Aurora[/color]. Que alívio ver um rosto amigável no meio de tanto caos."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_piyaa"]
script = ExtResource("8_t6lab")
text = "Sr. Bisão! O senhor parece exausto. Onde está todo mundo? A praça está tão [color=gray]vazia...[/color]"
duration = 1.0
portrait = ExtResource("10_t6lab")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_p4me5"]
script = ExtResource("8_t6lab")
text = "Eles se foram, minha jovem. O [color=gold]Rei[/color], os [color=gold]nobres[/color]... todos aqueles que deveriam nos proteger."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_f8k26"]
script = ExtResource("8_t6lab")
text = "Assim que a [color=aqua]água limpa[/color] e a [color=orange]comida[/color] começaram a faltar, eles encheram suas carroças com tudo o que restava e fugiram. Nos deixaram para trás, à mercê da própria sorte."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_v3wyh"]
script = ExtResource("8_t6lab")
text = "[shake rate=20 level=5]Mas isso é muito injusto![/shake] Eles não podem simplesmente nos descartar assim. Como as pessoas da vila vão sobreviver?"
duration = 1.0
portrait = ExtResource("10_t6lab")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_0ogkc"]
script = ExtResource("8_t6lab")
text = "Essa é a triste realidade de quem não tem poder. O [color=indianred]desespero[/color] já está tomando conta das famílias lá fora."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_gca0j"]
script = ExtResource("8_t6lab")
text = "Meus ossos velhos e esta bagagem já pesam demais, [color=lightblue]Aurora[/color]. Eu não consigo mais ajudar a todos como antigamente... mas você consegue. Você tem pernas ágeis e um coração valente."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_ix6yp"]
script = ExtResource("8_t6lab")
text = "Eu farei o que for preciso, Sr. Bisão. [wave amp=20 freq=5]Pode contar comigo![/wave] Por onde eu começo?"
duration = 1.0
portrait = ExtResource("10_t6lab")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_pcee7"]
script = ExtResource("8_t6lab")
text = "Passe por aquela porta. Você encontrará moradores que estão em situações críticas e perderam a esperança."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

[sub_resource type="Resource" id="Resource_p6m78"]
script = ExtResource("8_t6lab")
text = "Vá, pequena. Mostre a eles que, mesmo esquecidos pelo [color=gold]Rei[/color], nós não esquecemos uns dos outros."
duration = 1.0
portrait = ExtResource("9_p4me5")
metadata/_custom_type_script = "uid://cqx633eegleoo"

